        <name>Campus360 Interview QR Attendance</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {

    data.interview = null;
    data.error = '';
    data.success = false;

    // Mark Present
    if (input && input.action == 'mark_present') {

        var gr = new GlideRecord('x_snc_campus360_mock_interview');

        if (gr.get(input.interview_id)) {

            // Prevent QR reuse
            if (gr.getValue('qr_status') == 'Scanned' ||
                gr.getValue('attendance_status') == 'Present') {

                data.success = false;
                data.already_scanned = true;
                data.error = 'This QR code has already been scanned.';

                return;
            }

            // Mark attendance
            gr.setValue('attendance_status', 'Present');
            gr.setValue('qr_status', 'Scanned');
            gr.update();

            data.success = true;
            data.already_scanned = false;
            data.message = 'Attendance marked as Present';

        } else {

            data.success = false;
            data.error = 'Interview record not found';
        }

        return;
    }

    // Load interview
    var interviewId = $sp.getParameter('interview_id');

    if (!interviewId) {
        data.error = 'Interview ID is missing.';
        return;
    }

    var gr = new GlideRecord('x_snc_campus360_mock_interview');

    if (!gr.get(interviewId)) {
        data.error = 'Interview Not Found';
        return;
    }

    data.interview = {
        sys_id: gr.getUniqueValue(),
        interview_id: gr.getValue('interview_id'),
        student: gr.student.getDisplayValue(),
        interview_date: gr.getDisplayValue('interview_date'),
        interview_type: gr.getDisplayValue('interview_type'),
        start_time: gr.getDisplayValue('start_time'),
        end_time: gr.getDisplayValue('end_time'),
        attendance_status: gr.getDisplayValue('attendance_status'),
        qr_status: gr.getDisplayValue('qr_status')
    };

})();]]></script>
