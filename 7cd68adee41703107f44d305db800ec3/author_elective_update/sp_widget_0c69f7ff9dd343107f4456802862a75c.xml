        <template><![CDATA[<div class="panel panel-default" style="max-width:700px;margin:40px auto;">
  <div class="panel-heading text-center">
    <h2>Campus360 Interview Attendance</h2>
  </div>

  <div class="panel-body text-center">

    <div ng-if="data.loading">
      <h4>Loading interview...</h4>
    </div>

    <div ng-if="data.error" class="alert alert-danger">
      <h3>Interview Not Found</h3>
      <p>{{data.error}}</p>
    </div>

    <div ng-if="!data.loading && !data.error">

      <h3>{{data.interview_id}}</h3>

      <hr>

      <p><strong>Student:</strong> {{data.student}}</p>
      <p><strong>Interview Date:</strong> {{data.interview_date}}</p>
      <p><strong>Interview Type:</strong> {{data.interview_type}}</p>
      <p><strong>Start Time:</strong> {{data.start_time}}</p>
      <p><strong>End Time:</strong> {{data.end_time}}</p>

      <hr>

      <h3>Attendance Status</h3>

      <button class="btn btn-success"
              ng-click="c.markPresent()"
              ng-if="c.data.interview.attendance_status != 'Present'">
          Mark Present
      </button>

    </div>

  </div>
</div>]]></template>
