<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="DELETE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function() {

    var c = this;

    c.markPresent = function() {

        c.server.get({
            action: 'mark_present',
            interview_id: c.data.interview.sys_id
        }).then(function(response) {

            if (response.data.already_scanned) {

                c.data.error = 'This QR code has already been scanned.';
                c.data.already_scanned = true;

            } else if (response.data.success) {

                c.data.interview.attendance_status = 'Present';
                c.data.interview.qr_status = 'Scanned';
                c.data.message = response.data.message;

            } else {

                c.data.error = response.data.error;

            }

        });

    };

};]]></client_script>
