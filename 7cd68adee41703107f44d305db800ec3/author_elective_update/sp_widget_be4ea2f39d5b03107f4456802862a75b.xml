        <name>Campus360 QR Attendance Processor</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {

    data.success = false;
    data.message = '';
    data.debug = '';

    var inputId = $sp.getParameter('interview_id');

    if (!inputId) {
        data.message = 'ERROR: interview_id is missing from URL.';
        return;
    }

    var gr = new GlideRecord('x_snc_campus360_mock_interview');

    if (!gr.isValid()) {
        data.message = 'ERROR: Mock Interview table is invalid.';
        return;
    }

    /*
     * First try sys_id
     */
    var found = false;

    if (inputId.length == 32 && gr.get(inputId)) {
        found = true;
    }

    /*
     * If URL contains INT004 instead of sys_id,
     * find the record using interview_id.
     */
    if (!found) {

        gr = new GlideRecord('x_snc_campus360_mock_interview');

        gr.addQuery('interview_id', inputId);
        gr.query();

        if (gr.next()) {
            found = true;
        }
    }

    if (!found) {
        data.message =
            'ERROR: No Mock Interview record found for: ' + inputId;
        return;
    }

    /*
     * Record information
     */
    data.debug =
        'Record found successfully.' +
        ' | Sys ID = ' + gr.getUniqueValue() +
        ' | Interview ID = ' + gr.getValue('interview_id') +
        ' | Attendance = ' + gr.getDisplayValue('attendance_status') +
        ' | QR Status = ' + gr.getDisplayValue('qr_status') +
        ' | Record Can Write = ' + gr.canWrite() +
        ' | Attendance Can Write = ' +
            gr.getElement('attendance_status').canWrite() +
        ' | QR Can Write = ' +
            gr.getElement('qr_status').canWrite();

    /*
     * Validate fields
     */
    if (!gr.isValidField('attendance_status')) {
        data.message = 'ERROR: attendance_status field does not exist.';
        return;
    }

    if (!gr.isValidField('qr_status')) {
        data.message = 'ERROR: qr_status field does not exist.';
        return;
    }

    /*
     * Check field ACLs
     */
    if (!gr.getElement('attendance_status').canWrite()) {
        data.message =
            'ERROR: attendance_status field is NOT writable.';
        return;
    }

    if (!gr.getElement('qr_status').canWrite()) {
        data.message =
            'ERROR: qr_status field is NOT writable.';
        return;
    }

    /*
     * Get actual choice values
     */
    var attendanceElement = gr.getElement('attendance_status');
    var qrElement = gr.getElement('qr_status');

    data.debug +=
        ' | Current Attendance Value = ' +
        attendanceElement.getValue();

    data.debug +=
        ' | Current QR Value = ' +
        qrElement.getValue();

    /*
     * Set values
     */
    gr.setValue('attendance_status', 'Present');
    gr.setValue('qr_status', 'Scanned');

    /*
     * Show what ServiceNow thinks we are setting
     */
    data.debug +=
        ' | New Attendance Value = ' +
        gr.getValue('attendance_status');

    data.debug +=
        ' | New QR Value = ' +
        gr.getValue('qr_status');

    /*
     * Update
     */
    var result = gr.update();

    if (!result) {

        data.message =
            'ERROR: gr.update() failed.' +
            ' | Last Error = ' +
            gr.getLastErrorMessage();

        return;
    }

    data.success = true;

    data.message =
        'Attendance marked successfully.' +
        ' Interview = ' +
        gr.getValue('interview_id');

})();]]></script>
