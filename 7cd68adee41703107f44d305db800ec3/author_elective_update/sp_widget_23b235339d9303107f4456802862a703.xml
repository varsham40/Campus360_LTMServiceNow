        <template><![CDATA[<div style="text-align:center; padding:40px;">

    <h1>Campus360 QR Attendance</h1>

    <div class="panel panel-default"
         style="max-width:700px; margin:30px auto; padding:40px;">

        <div ng-if="c.success">

            <h2 style="color:green;">
                ✓ Attendance Marked
            </h2>

            <p>
                {{c.message}}
            </p>

            <div ng-if="c.interviewNumber">
                <strong>Interview ID:</strong>
                {{c.interviewNumber}}
            </div>

        </div>

        <div ng-if="!c.success">

            <h2 style="color:red;">
                Attendance Failed
            </h2>

            <p ng-bind-html="c.message"></p>

        </div>

    </div>

</div>]]></template>
