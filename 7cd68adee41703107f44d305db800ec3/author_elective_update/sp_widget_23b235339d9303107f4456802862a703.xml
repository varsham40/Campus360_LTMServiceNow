        <name>Campus360 QR Attendance Processor</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {

    data.success = false;
    data.message = '';
    data.interviewNumber = '';

    var inputId = $sp.getParameter('interview_id');

    if (!inputId) {
        data.message = 'ERROR: interview_id is missing from the URL.';
        return;
    }

    var gr = new GlideRecord('x_snc_campus360_mock_interview');

    if (!gr.isValid()) {
        data.message = 'ERROR: Mock Interview table is invalid.';
        return;
    }

    /*
     * Support both:
     * 1. sys_id
     * 2. Interview ID such as INT004
     */

    var found = false;

    // First try sys_id
    if (inputId.length == 32) {
        found = gr.get(inputId);
    }

    // If not found, search using Interview ID
    if (!found) {

        gr.initialize();

        gr.addQuery('interview_id', inputId);
        gr.query();

        if (gr.next()) {
            found = true;
        }
    }

    if (!found) {
        data.message = 'ERROR: No Mock Interview record found for: ' + inputId;
        return;
    }

    // Store interview information
    data.interviewNumber = gr.getValue('interview_id');

    /*
     * DEBUG INFORMATION
     */
    var recordSysId = gr.getUniqueValue();
    var currentAttendance = gr.getValue('attendance_status');
    var currentQRStatus = gr.getValue('qr_status');

    /*
     * Prevent duplicate attendance
     */
    if (currentAttendance == 'Present') {

        data.success = true;

        data.message =
            'Attendance already marked for ' +
            data.interviewNumber + '.';

        return;
    }

    /*
     * Check write permission
     */
    if (!gr.canWrite()) {

        data.message =
            'ERROR: You do not have permission to update this Mock Interview record.';

        return;
    }

    /*
     * Update attendance
     */
    gr.setValue('attendance_status', 'Present');

    /*
     * Update QR status
     */
    gr.setValue('qr_status', 'Scanned');

    /*
     * Save record
     */
    var result = gr.update();

    /*
     * IMPORTANT:
     * Capture ServiceNow's actual error
     */
    if (!result) {

        var errorMessage = gr.getLastErrorMessage();

        if (!errorMessage) {
            errorMessage = 'Unknown ServiceNow update error.';
        }

        data.message =
            'ERROR: Unable to update Mock Interview record.' +
            '<br><br>' +
            'Interview: ' + data.interviewNumber +
            '<br>' +
            'Sys ID: ' + recordSysId +
            '<br>' +
            'Attendance Before: ' + currentAttendance +
            '<br>' +
            'QR Status Before: ' + currentQRStatus +
            '<br>' +
            'ServiceNow Error: ' + errorMessage;

        return;
    }

    /*
     * Re-read record and verify
     */
    var verify = new GlideRecord('x_snc_campus360_mock_interview');

    if (!verify.get(recordSysId)) {

        data.message =
            'ERROR: Record was updated but could not be re-read.';

        return;
    }

    var finalAttendance = verify.getValue('attendance_status');
    var finalQRStatus = verify.getValue('qr_status');

    /*
     * Confirm values
     */
    if (finalAttendance == 'Present' &&
        finalQRStatus == 'Scanned') {

        data.success = true;

        data.message =
            'Attendance marked successfully!' +
            '<br><br>' +
            '<strong>Interview:</strong> ' +
            data.interviewNumber +
            '<br>' +
            '<strong>Attendance:</strong> Present' +
            '<br>' +
            '<strong>QR Status:</strong> Scanned';

        return;
    }

    /*
     * Update happened but values were not saved correctly
     */
    data.message =
        'ERROR: Record update completed, but verification failed.' +
        '<br><br>' +
        'Attendance = ' + finalAttendance +
        '<br>' +
        'QR Status = ' + finalQRStatus;

})();]]></script>
