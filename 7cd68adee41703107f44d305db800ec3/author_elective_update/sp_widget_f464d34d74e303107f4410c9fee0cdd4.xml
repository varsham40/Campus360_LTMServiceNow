        <script><![CDATA[(function() {

    data.stats = {
        applications: 0,
        assessments: 0,
        shortlisted: 0,
        interviews: 0,
        offers: 0
    };

    data.assessment = {
        passed: 0,
        failed: 0,
        pending: 0
    };

    data.interviews = {
        selected: 0,
        rejected: 0,
        pending: 0
    };


    // ==============================
    // APPLICATIONS
    // ==============================

    var app = new GlideRecord('x_snc_campus360_student_application');
    app.query();

    while (app.next()) {

        data.stats.applications++;

        var shortlisted =
            app.getValue('shortlisted');

        if (shortlisted == 'true' || shortlisted == '1') {
            data.stats.shortlisted++;
        }
    }


    // ==============================
    // ASSESSMENTS
    // ==============================

    var assessment =
        new GlideRecord('x_snc_campus360_student_assessment');

    assessment.query();

    while (assessment.next()) {

        data.stats.assessments++;

        var result =
            (assessment.getDisplayValue('result') || '')
            .toLowerCase();

        if (result == 'passed' ||
            result == 'pass' ||
            result == 'selected') {

            data.assessment.passed++;

        } else if (result == 'failed' ||
                   result == 'fail' ||
                   result == 'rejected') {

            data.assessment.failed++;

        } else {

            data.assessment.pending++;
        }
    }


    // ==============================
    // INTERVIEWS
    // ==============================

    var interview =
        new GlideRecord('x_snc_campus360_recruiter_interview');

    interview.query();

    while (interview.next()) {

        data.stats.interviews++;

        var interviewResult =
            (interview.getDisplayValue('result') || '')
            .toLowerCase();

        if (interviewResult == 'selected' ||
            interviewResult == 'accepted' ||
            interviewResult == 'next round') {

            data.interviews.selected++;

        } else if (interviewResult == 'rejected') {

            data.interviews.rejected++;

        } else {

            data.interviews.pending++;
        }
    }


    // ==============================
    // OFFERS
    // ==============================

    /*
     * Offer table may not exist yet.
     * Keep this at 0 until Offer Management
     * is created.
     */

    data.stats.offers = 0;


})();]]></script>
