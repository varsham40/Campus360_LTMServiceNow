}]]&gt;&lt;/link&gt;&lt;name&gt;Recruiter Analytics&lt;/name&gt;&lt;option_schema/&gt;&lt;public&gt;false&lt;/public&gt;&lt;roles/&gt;&lt;script&gt;&lt;![CDATA[(function() {

    data.stats = {
        applications: 0,
        assessments: 0,
        shortlisted: 0,
        interviews: 0,
        offers: 0
    };

    data.assessment = {
        passed: 0,
        failed: 0,
        pending: 0
    };

    data.interviews = {
        selected: 0,
        rejected: 0,
        pending: 0
    };


    // ==============================
    // APPLICATIONS
    // ==============================

    var app = new GlideRecord('x_snc_campus360_student_application');
    app.query();

    while (app.next()) {

        data.stats.applications++;

        var shortlisted =
            app.getValue('shortlisted');

        if (shortlisted == 'true' || shortlisted == '1') {
            data.stats.shortlisted++;
        }
    }


    // ==============================
    // ASSESSMENTS
    // ==============================

    var assessment =
        new GlideRecord('x_snc_campus360_student_assessment');

    assessment.query();

    while (assessment.next()) {

        data.stats.assessments++;

        var result =
            (assessment.getDisplayValue('result') || '')
            .toLowerCase();

        if (result == 'passed' ||
            result == 'pass' ||
            result == 'selected') {

            data.assessment.passed++;

        } else if (result == 'failed' ||
                   result == 'fail' ||
                   result == 'rejected') {

            data.assessment.failed++;

        } else {

            data.assessment.pending++;
        }
    }


    // ==============================
    // INTERVIEWS
    // ==============================

    var interview =
        new GlideRecord('x_snc_campus360_recruiter_interview');

    interview.query();

    while (interview.next()) {

        data.stats.interviews++;

        var interviewResult =
            (interview.getDisplayValue('result') || '')
            .toLowerCase();

        if (interviewResult == 'selected' ||
            interviewResult == 'accepted' ||
            interviewResult == 'next round') {

            data.interviews.selected++;

        } else if (interviewResult == 'rejected') {

            data.interviews.rejected++;

        } else {

            data.interviews.pending++;
        }
    }


    // ==============================
    // OFFERS
    // ==============================

    /*
     * Offer table may not exist yet.
     * Keep this at 0 until Offer Management
     * is created.
     */

    data.stats.offers = 0;


})();]]&gt;&lt;/script&gt;&lt;servicenow&gt;false&lt;/servicenow&gt;&lt;sys_class_name&gt;sp_widget&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-09-24 06:58:13&lt;/sys_created_on&gt;&lt;sys_id&gt;f464d34d74e303107f4410c9fee0cdd4&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_name&gt;Recruiter Analytics&lt;/sys_name&gt;&lt;sys_package display_value="Campus360" source="x_snc_campus360"&gt;7cd68adee41703107f44d305db800ec3&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Campus360"&gt;7cd68adee41703107f44d305db800ec3&lt;/sys_scope&gt;&lt;sys_update_name&gt;sp_widget_f464d34d74e303107f4410c9fee0cdd4&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-09-24 06:58:13&lt;/sys_updated_on&gt;&lt;template&gt;&lt;![CDATA[&lt;div class="analytics-page"&gt;

