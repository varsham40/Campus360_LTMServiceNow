        <script><![CDATA[(function executeRule(current, previous) {

    var score = parseFloat(current.getValue('score'));
    var maximum = parseFloat(current.getValue('maximum_score'));

    if (isNaN(score)) {
        score = 0;
    }

    if (isNaN(maximum) || maximum <= 0) {
        maximum = 100;
    }

    // Calculate percentage
    var percentage = (score / maximum) * 100;

    current.setValue(
        'percentage',
        Math.round(percentage * 100) / 100
    );

    // Assessment completed
    current.setValue('status', 'completed');

    // Result
    if (percentage >= 60) {
        current.setValue('result', 'passed');
    } else {
        current.setValue('result', 'failed');
    }

})(current, previous);]]></script>
